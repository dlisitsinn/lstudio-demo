# ===== Настройки демо-бота LStudio =====
# Значение пишется сразу после знака «=». Никому не пересылайте этот файл.

# Токен ВК — чтобы бот сам брал название, фото и цены из группы по ссылке.
# Можно оставить пустым: если рядом лежит папка основного бота lstudio-bot, токен возьмётся оттуда.
VK_USER_TOKEN=

# Обновления: бот сам обновляется с GitHub при запуске. Чтобы выключить — AUTO_UPDATE=нет
AUTO_UPDATE=да
